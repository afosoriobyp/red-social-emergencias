# MongoDB Atlas connection string (opcional: si omites, usa modo demo en memoria)
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<BASEDATOS>?retryWrites=true&w=majority"

# Secreto para firmar sesiones JWT (¡genera uno largo y aleatorio!)
AUTH_SECRET="cambia-esto-a-una-cadena-larga-y-aleatoria"

# Teléfonos (código de país, sin +) que se registran como ADMIN. Separados por coma.
ADMIN_PHONES=""

# Contacto WhatsApp por defecto para reenvío de alertas (opcional)
DEFAULT_WHATSAPP=""
NEXT_PUBLIC_DEFAULT_WHATSAPP=""

# Web Push (VAPID) - genera con: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tudominio.com"

# Redis URL para SSE multi-instancia (producción - opcional)
# REDIS_URL="redis://user:pass@host:6379"
